NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
INQUIRY_API_URL=http://127.0.0.1:4001
# back/dev/.env의 INQUIRY_API_TOKEN과 동일한 값을 입력합니다. 브라우저에 노출하지 않습니다.
INQUIRY_API_TOKEN=
# Vercel Production에서는 INQUIRY_API_URL에 다음 HTTPS 주소를 설정합니다.
# https://heavily-nag-subway.ngrok-free.dev/homepage-api
# 공유 ngrok 경로는 Mac에 구성되어 있으며, Vercel 환경변수는 별도로 설정합니다.
